		"next": "^16.2.9",
		"pixi.js": "^8.4.0",
		"playwright-extra-plugin-stealth": "^0.0.1",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"winston": "^3.13.0"
	},
	"devDependencies": {
		"@playwright/test": "^1.60.0",
		"@testing-library/dom": "^9.0.0",
