{
	"name": "finra-data-chart-next-02",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "bash .local/scripts/start-local-redis.sh && NODE_OPTIONS=--max-old-space-size=8192 next dev -p 4444",
		"dev:clean": "bash .local/scripts/start-local-redis.sh && rm -rf .next && next dev -p 4444",
		"redis:start": "bash /home/lenny/Dev/db/redis/start-redis.sh",
		"redis:commander": "npx --yes redis-commander --noload --nosave --redis-host 127.0.0.1 --redis-port 6379 --redis-db 0 --redis-label local --address 127.0.0.1 --port 8081",
		"prebuild": "node .local/scripts/prebuild.js",
		"build": "NODE_OPTIONS=--max-old-space-size=8192 node .local/scripts/build_search_indexes.js && NODE_OPTIONS=--max-old-space-size=8192 next build --webpack && node .local/scripts/copy-search-indexes.js",
		"start": "NODE_OPTIONS=--max-old-space-size=8192 next start -p 4444",
		"lint": "next lint",
		"test:unit": "vitest",
		"test:e2e": "playwright test",
		"test:e2e:headed": "playwright test --headed",
		"test:smoke": "playwright test tests/e2e/smoke.spec.ts tests/e2e/firm-connection-bidirectional.spec.ts",
		"ci:install-browsers": "npx playwright install --with-deps || npx playwright install chromium",
		"vercel-build": "pnpm run build"
	},
	"dependencies": {
		"@upstash/redis": "^1.37.0",
		"@vercel/analytics": "^2.0.1",
		"@vercel/speed-insights": "^2.0.0",
